# ─── Required ───────────────────────────────────────────
# Hostinger hPanel → Databases → MySQL Databases. Host is usually "localhost" on the same hosting account.
# URL-encode special characters in the password (@ → %40, # → %23, etc.)
DATABASE_URL="mysql://u123456789_nextdel:YOUR_DB_PASSWORD@localhost:3306/u123456789_nextdel"

# Public URL of the site, no trailing slash
SITE_URL="https://yourdomain.com"

# Long random string (64+ chars). Encrypts stored secrets & signs download links.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NEVER change it after go-live, otherwise saved gateway/SMTP secrets cannot be decrypted.
APP_SECRET="change-me-to-a-long-random-string"

# ─── Optional ───────────────────────────────────────────
# Where uploaded files live. Use an absolute path OUTSIDE the app folder on Hostinger
# so redeploys don't wipe uploads, e.g. /home/u123456789/nextdel-storage
STORAGE_DIR="./storage"

# Enables the one-time /admin/setup page for creating the first admin (when no admin exists).
# Remove it after creating the admin.
ADMIN_SETUP_TOKEN=""

# Secret for the reconciliation cron endpoint: /api/cron/reconcile?key=...
CRON_SECRET=""
